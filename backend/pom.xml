<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.team12.hms</groupId>
    <artifactId>hotel-management-system-backend</artifactId>
    <version>1.0.0</version>
    <name>Hotel Management System Backend</name>
    <description>Enterprise Hotel Management System - Spring Boot 3 &amp; PostgreSQL v2</description>

    <properties>
        <java.version>17</java.version>
        <flyway.version>10.11.0</flyway.version>
        <pitest.version>1.15.8</pitest.version>
        <pitest-junit5.version>1.2.1</pitest-junit5.version>
        <testcontainers.version>1.19.7</testcontainers.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Database & Flyway Migration -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- Testing & Verification -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>../db/migration</directory>
                <targetPath>db/migration</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- PITest Mutation Testing -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest-junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.team12.hms.domain.billing.BillingService*</param>
                        <param>com.team12.hms.domain.common.MoneyUtils*</param>
                        <param>com.team12.hms.domain.reservation.CancellationPolicy*</param>
                        <param>com.team12.hms.domain.reservation.GuestInfo*</param>
                        <param>com.team12.hms.domain.auth.AuthorizationPolicy*</param>
                        <param>com.team12.hms.domain.auth.PasswordValidator*</param>
                        <param>com.team12.hms.domain.auth.AuthToken*</param>
                        <param>com.team12.hms.domain.auth.User*</param>
                        <param>com.team12.hms.domain.room.Room*</param>
                        <param>com.team12.hms.domain.room.RoomType*</param>
                        <param>com.team12.hms.domain.config.SystemConfig*</param>
                    </targetClasses>
                    <excludedClasses>
                        <param>com.team12.hms.domain.billing.Invoice*</param>
                        <param>com.team12.hms.domain.reservation.Reservation*</param>
                        <param>com.team12.hms.domain.housekeeping.CleaningTask*</param>
                        <param>com.team12.hms.domain.common.DomainExceptions*</param>
                    </excludedClasses>
                    <targetTests>
                        <param>com.team12.hms.domain.*Test</param>
                    </targetTests>
                    <mutationThreshold>90</mutationThreshold>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
